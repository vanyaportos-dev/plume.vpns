{
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/api/vpn/(.*)", "destination": "/api/vpn.js" },
    { "source": "/api/auth/telegram/miniapp", "destination": "/api/auth/telegram/miniapp.js" },
    { "source": "/api/auth/me", "destination": "/api/auth/me.js" },
    { "source": "/api/auth/logout", "destination": "/api/auth/logout.js" },
    { "source": "/api/webhook", "destination": "/api/webhook.js" },
    { "source": "/api/adaptgroup", "destination": "/api/adaptgroup.js" },
    { "source": "/api/lib/redis", "destination": "/api/lib/redis.js" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ]
}
